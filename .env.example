# Zetaris Gateway origin: use the origin from your working SQL Workspace.
ZETARIS_BASE_URL=https://your-working-gateway.example
ZETARIS_API_KEY=
# Numeric organisation ID; leave empty until verified in Gateway.
ZETARIS_ORG_ID=
# Nebius Token Factory, server-side only.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
# Leave blank until the account model catalog has been checked.
NEMOTRON_MODEL=
# Copy the actual OpenAI-compatible endpoint from Nightshift's AI Hotspot.
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=
# local = fixtures without cloud source reads; zetaris = fail-closed live queries.
DATA_BACKEND=local
